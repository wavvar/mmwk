# Application-owned asset catalog. No sibling source checkout or SDK-private
# board-specific firmware choice is permitted for the public presence example.
# Include after project() so IDF_TARGET and sdkconfig board selections exist.
function(presence_resolve_asset_profile radar_root)
    if(CONFIG_RADAR_BOARD_MINI)
        set(_board "MINI")
        set(_target "esp32")
        set(_chip "6843")
        set(_family "radar68xx")
    elseif(CONFIG_RADAR_BOARD_PRO)
        set(_board "PRO")
        set(_target "esp32s3")
        set(_chip "6843")
        set(_family "radar68xx")
    elseif(CONFIG_RADAR_BOARD_WDR)
        set(_board "WDR")
        set(_target "esp32s3")
        set(_chip "6432")
        set(_family "radarl64xx")
    else()
        message(FATAL_ERROR "presence: unsupported public board profile; choose MINI, PRO or WDR")
    endif()

    if(NOT "${IDF_TARGET}" STREQUAL "${_target}" OR
       NOT "${CONFIG_RADAR_BOARD_RADAR_CHIP}" STREQUAL "${_chip}" OR
       NOT "${CONFIG_RADAR_BOARD_NAME}" STREQUAL "${_board}")
        message(FATAL_ERROR "presence: board, target and radar chip do not match the approved asset profile")
    endif()

    if(MMWK_PRESENCE_AGGREGATE_ASSETS)
        set(_dir "${radar_root}/${_family}")
    elseif("${_family}" STREQUAL "radarl64xx")
        set(_dir "${radar_root}/iwrl6432/presence")
        set(_fw "presence.appimage")
        set(_cfg "presence.cfg")
        set(_version "xWRL6432 MMW Demo 05.05.03.00")
        set(_fid 1)
    else()
        set(_dir "${radar_root}/iwr6843/oob")
        set(_fw "out_of_box_6843_aop.bin")
        set(_cfg "out_of_box_6843_aop.cfg")
        set(_version "03.06.00.00")
        set(_fid 2)
    endif()

    if(MMWK_PRESENCE_AGGREGATE_ASSETS)
        if("${_family}" STREQUAL "radarl64xx")
            set(_fw "presence.appimage")
            set(_cfg "presence.cfg")
            set(_version "xWRL6432 MMW Demo 05.05.03.00")
            set(_fid 1)
        else()
            set(_fw "out_of_box_6843_aop.bin")
            set(_cfg "out_of_box_6843_aop.cfg")
            set(_version "03.06.00.00")
            set(_fid 2)
        endif()
    endif()
    if(IS_SYMLINK "${_dir}" OR IS_SYMLINK "${_dir}/${_fw}" OR IS_SYMLINK "${_dir}/${_cfg}")
        message(FATAL_ERROR "presence: symlinked radar firmware/config is forbidden")
    endif()
    if(NOT EXISTS "${_dir}/${_fw}" OR NOT EXISTS "${_dir}/${_cfg}")
        message(FATAL_ERROR "presence: firmware/config pair missing from native public radar assets")
    endif()
    set(PRESENCE_RADAR_FAMILY "${_family}" PARENT_SCOPE)
    set(PRESENCE_RADAR_FW_SRC "${_dir}/${_fw}" PARENT_SCOPE)
    set(PRESENCE_RADAR_CFG_SRC "${_dir}/${_cfg}" PARENT_SCOPE)
    set(PRESENCE_RADAR_FW_NAME "${_fw}" PARENT_SCOPE)
    set(PRESENCE_RADAR_CFG_NAME "${_cfg}" PARENT_SCOPE)
    set(PRESENCE_RADAR_VERSION "${_version}" PARENT_SCOPE)
    set(PRESENCE_RADAR_FID "${_fid}" PARENT_SCOPE)
endfunction()

# Content-address the source pair so previous build's SPIFFS files cannot
# mix with another board or a changed radar firmware/config revision.
function(presence_resolve_asset_staging_dir build_root family firmware config output)
    if(NOT IS_ABSOLUTE "${build_root}" OR
       NOT EXISTS "${firmware}" OR NOT EXISTS "${config}")
        message(FATAL_ERROR "presence: invalid asset staging inputs")
    endif()
    if(NOT "${family}" MATCHES "^(radar68xx|radarl64xx)$")
        message(FATAL_ERROR "presence: unsafe asset staging family")
    endif()
    file(SHA256 "${firmware}" _firmware_sha)
    file(SHA256 "${config}" _config_sha)
    set(${output}
        "${build_root}/presence_assets/${family}/${_firmware_sha}-${_config_sha}"
        PARENT_SCOPE)
endfunction()

# Check existing generated SPIFFS inputs before any file(COPY) or WRITE.
# A stale meta.json symlink must not redirect build output outside the tree.
function(presence_validate_asset_staging stage firmware_name config_name)
    if(IS_SYMLINK "${stage}")
        message(FATAL_ERROR "presence: linked SPIFFS staging directory")
    endif()
    file(GLOB _staged_paths LIST_DIRECTORIES true "${stage}/*")
    foreach(_candidate IN LISTS _staged_paths)
        if(IS_SYMLINK "${_candidate}" OR IS_DIRECTORY "${_candidate}")
            message(FATAL_ERROR "presence: unsafe link or directory in SPIFFS staging")
        endif()
        get_filename_component(_name "${_candidate}" NAME)
        if(NOT _name STREQUAL "${firmware_name}" AND
           NOT _name STREQUAL "${config_name}" AND
           NOT _name STREQUAL "meta.json")
            message(FATAL_ERROR "presence: unexpected firmware file in SPIFFS staging")
        endif()
    endforeach()
endfunction()
